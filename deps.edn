{:deps
 {rhizome/rhizome {:mvn/version "0.2.9"}
  macroz/tangle {:mvn/version "0.2.2"}
  org.clojure/test.check {:mvn/version "1.1.0"}
  com.clojure-goes-fast/clj-async-profiler {:mvn/version "0.5.1"}
  ;; keccak256 for the BEEFY-compatible hash backend (KeccakDigest, NOT SHA3: different padding)
  org.bouncycastle/bcprov-jdk18on {:mvn/version "1.78.1"}}
 :aliases {:profiling
           {:jvm-opts
            ["-Djdk.attach.allowAttachSelf"
             "-XX:+UnlockDiagnosticVMOptions"
             "-XX:+DebugNonSafepoints"]}
           :test
           {:jvm-opts ["-Djava.awt.headless=true" "-Dmmb.verify-reuse=true"]
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            ;; -d src sets the scan path; the two -n filters select paper-test (figures/lemmas)
            ;; and linked-peaks (cache-aligned etc., which live in the impl namespace).
            ;; proof-size runs its deftest at load.
            :main-opts ["-m" "cognitect.test-runner" "-d" "src" "-n" "linked-peaks" "-n" "paper-test"]}
           :test-thorough
           {:jvm-opts ["-Djava.awt.headless=true" "-Dmmb.thorough=true" "-Dmmb.verify-reuse=true"]
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            ;; -d src sets the scan path; the two -n filters select paper-test (figures/lemmas)
            ;; and linked-peaks (cache-aligned etc., which live in the impl namespace).
            ;; proof-size runs its deftest at load.
            :main-opts ["-m" "cognitect.test-runner" "-d" "src" "-n" "linked-peaks" "-n" "paper-test"]}
           :test-xxl
           ;; cache-aligned-xxl only: rebuilds the n=30M reference in-process (~12GB live).
           ;; needs a machine with >=40GB free; heap kept under 32g to retain compressed oops
           ;; (this workload is nearly all pointers). SMALL young gen on purpose: the live
           ;; node-map is long-lived and grows to ~12GB, so it must promote to old gen fast;
           ;; a large young gen makes each collection copy GBs between survivor spaces
           ;; (measured: -Xmn12g 4.8k appends/s vs -Xmn2g 111k/s). on demand, not CI cadence.
           {:jvm-opts ["-Djava.awt.headless=true" "-Dmmb.xxl=true"
                       "-Xmx30g" "-Xmn2g" "-XX:+UseParallelGC"]
            :extra-deps {io.github.cognitect-labs/test-runner
                         {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
            :main-opts ["-m" "cognitect.test-runner" "-d" "src" "-n" "linked-peaks" "-v" "linked-peaks/cache-aligned-xxl"]}}}
